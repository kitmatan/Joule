    "Whenever possible, avoid consecutive DC rapid charges in high ambient heat without cool-down intervals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeiden Sie nach Möglichkeit aufeinanderfolgende DC-Schnellladungen bei großer Hitze ohne Abkühlpause."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whenever possible, avoid consecutive DC rapid charges in high ambient heat without cool-down intervals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite cargas rápidas consecutivas en CC con calor extremo sin pausas de enfriamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez autant que possible les recharges rapides DC consécutives par forte chaleur sans temps de refroidissement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高温環境下で冷却時間を置かずに連続して急速充電を行うことは極力避けてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unngå om mulig gjentatte DC-hurtigladinger i høy varme uten nedkjølingspauser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลีกเลี่ยงการชาร์จเร็ว DC ต่อเนื่องหลายครั้งติดกันในสภาพอากาศร้อนจัดโดยไม่มีช่วงพักระบายความร้อน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在高温天气下尽量避免在没有冷却间隔的情况下连续进行多次直流快充。"
          }
        }
      }
    },
