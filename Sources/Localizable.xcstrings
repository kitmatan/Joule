    "Are you sure you want to delete %@? Any charging sessions previously linked to this car will remain in your history and reassign to your primary vehicle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie %1$@ wirklich löschen? Zugehörige Ladevorgänge bleiben im Verlauf und werden Ihrem Hauptfahrzeug zugewiesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete %1$@? Any charging sessions previously linked to this car will remain in your history and reassign to your primary vehicle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que deseas eliminar %1$@? Las sesiones vinculadas se conservarán en tu historial y se reasignarán a tu vehículo principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment supprimer %1$@ ? Les sessions associées resteront dans l'historique et seront réattribuées à votre véhicule principal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ を削除してもよろしいですか？関連付けられていた充電セッションは履歴に残り、メイン車両に再割り当てされます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slette %1$@? Ladeøkter knyttet til denne bilen forblir i historikken og tilordnes hovedkjøretøyet ditt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณแน่ใจหรือไม่ว่าต้องการลบ %1$@? ข้อมูลการชาร์จของรถคันนี้จะยังคงอยู่ในประวัติและถูกย้ายไปยังรถหลักของคุณ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定要删除 %1$@ 吗？之前关联至该车辆的充电记录将保留在历史中，并重新归属至您的主车辆。"
          }
        }
      }
    },
