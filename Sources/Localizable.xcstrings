          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nickel-cobalt-aluminium (NCA)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ニッケル・コバルト・アルミニウム (NCA)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
