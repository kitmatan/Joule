          }
        }
      }
    },
    "You consistently recharge before your battery drops into deep discharge territory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie laden stets nach, bevor der Akku in den Tiefentladungsbereich gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You consistently recharge before your battery drops into deep discharge territory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recarga constantemente antes de que la batería caiga en descarga profunda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
