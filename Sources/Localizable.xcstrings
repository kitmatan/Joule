    "This resets battery capacity, range, and cycle benchmarks back to %@ factory defaults." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt Batteriekapazität, Reichweite und Zyklen-Benchmarks auf die Werkseinstellungen von %1$@ zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This resets battery capacity, range, and cycle benchmarks back to %1$@ factory defaults."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto restablece la capacidad, autonomía y ciclos a los valores de fábrica de %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablit la capacité, l'autonomie et les cycles par défaut selon les spécifications d'usine %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー容量、航続距離、サイクル基準値を %1$@ の工場出荷時デフォルトに戻します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette tilbakestiller batterikapasitet, rekkevidde og syklusreferanser til %1$@ fabrikkstandard."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะรีเซ็ตความจุแบตเตอรี่ ระยะทาง และรอบชาร์จ กลับเป็นค่าเริ่มต้นจากโรงงานของ %1$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会将电池容量、续航与循环基准重置为 %1$@ 的出厂默认值。"
          }
        }
      }
    },
    "This resets vehicle specifications and tariffs back to default factory specifications." : {
      "localizations" : {
        "de" : {
