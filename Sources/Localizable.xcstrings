    "Start tracking your charging sessions to unlock real-time monthly costs, gas savings comparison, and battery State of Health (SoH) analytics." : {
      "comment" : "A description of the benefits of using the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starten Sie das Erfassen von Ladevorgängen, um monatliche Kosten, Benzinersparnis und Batteriegesundheitsanalysen freizuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start tracking your charging sessions to unlock real-time monthly costs, gas savings comparison, and battery State of Health (SoH) analytics."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comienza a registrar tus cargas para desbloquear costos mensuales en tiempo real, ahorro vs gasolina y estado de salud (SoH) de la batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez vos recharges pour débloquer les coûts mensuels, la comparaison vs essence et l'état de santé (SoH) de la batterie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充電セッションの追跡を開始して、月々の充電コスト、ガソリン車との比較、バッテリー健全度 (SoH) 分析を確認しましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynn å spore ladeøktene dine for å se månedlige kostnader, bensinbesparelser og batterihelseanalyser (SoH)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มบันทึกการชาร์จของคุณเพื่อดูค่าใช้จ่ายรายเดือน การเปรียบเทียบการประหยัดค่าน้ำมัน และการวิเคราะห์สุขภาพแบตเตอรี่ (SoH) แบบเรียลไทม์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始记录您的充电记录，以实时了解每月花费、燃油节省对比以及电池健康状态 (SoH) 分析。"
          }
        }
      }
    },
    "Starting below 15% increases anode internal resistance. Aim to plug in around 15%–20% buffer." : {
      "comment" : "A warning for starting a session below 15% battery capacity.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start unter 15 % erhöht den Innenwiderstand der Anode. Empfohlen: Einstecken bei ca. 15 %–20 % Restpuffer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starting below 15% increases anode internal resistance. Aim to plug in around 15%–20% buffer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar con menos del 15% aumenta la resistencia interna. Procura conectar alrededor del 15%–20%."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencer en dessous de 15 % augmente la résistance interne. Visez à brancher vers 15 %–20 %."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15% 未満からの充電は内部抵抗を高めます。15%〜20% 程度の余裕をもって充電することをおすすめします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lading som starter under 15 % øker indre motstand. Sikt på å koble til rundt 15 %–20 % buffer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเริ่มชาร์จเมื่อแบตต่ำกว่า 15% จะเพิ่มความต้านทานภายใน แนะนำให้เริ่มชาร์จที่ระดับ 15%–20%"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电量低于 15% 时开始充电会增加阳极内阻。建议在剩余 15%–20% 电量时连接充电。"
          }
        }
      }
    },
