    "Manage multiple EV profiles with custom battery chemistries, tariffs, and gas baselines." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalten Sie mehrere Elektrofahrzeug-Profile mit individueller Batteriechemie, Tarifen und Benzin-Referenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage multiple EV profiles with custom battery chemistries, tariffs, and gas baselines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administra múltiples perfiles de VE con químicas de batería, tarifas y líneas base de gasolina personalizadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez plusieurs profils de VE avec chimies de batterie, tarifs et références d'essence personnalisés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー種類、電気料金、ガソリン基準を車両ごとにカスタマイズして複数EVを一元管理できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrer flere elbilprofiler med tilpasset batterikjemi, tariffer og bensinreferanser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จัดการโปรไฟล์รถยนต์ไฟฟ้าหลายคัน พร้อมปรับแต่งเคมีแบตเตอรี่ อัตราค่าไฟ และเกณฑ์เปรียบเทียบน้ำมัน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理多辆电动车档案，支持自定义电池化学成分、家庭电价和燃油对比基准。"
          }
        }
      }
    },
