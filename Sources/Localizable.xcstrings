    "Use built-in vehicle navigation to navigate to fast chargers so the BMS automatically pre-heats/cools the pack." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie das bordeigene Navi zur Ladesäule, damit das BMS den Akku rechtzeitig temperiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use built-in vehicle navigation to navigate to fast chargers so the BMS automatically pre-heats/cools the pack."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use el navegador integrado para ir a cargadores rápidos y preacondicionar la batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le GPS intégré pour aller aux bornes rapides afin que le BMS préconditionne la batterie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車載ナビで充電スタンドを設定し、BMSが自動で温度調節できるようにしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk bilens integrerte navigasjon til hurtigladere slik at BMS automatisk tempererer batteriet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ระบบนำทางในรถนำทางไปยังตู้ชาร์จเร็ว เพื่อให้ระบบ BMS ปรับอุณหภูมิแบตเตอรี่ล่วงหน้าโดยอัตโนมัติ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用车载原厂导航前往快充站，以便 BMS 自动提前预热/预冷电池组。"
          }
        }
      }
    },
