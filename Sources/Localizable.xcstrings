          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นิกเกิลโคบอลต์อะลูมิเนียม (NCA)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
