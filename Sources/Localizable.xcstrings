    "If leaving your car unused for more than 2 weeks, set SoC to approximately 50%." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Auto länger als 2 Wochen steht, stellen Sie den SoC auf etwa 50% ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If leaving your car unused for more than 2 weeks, set SoC to approximately 50%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no usará el coche más de 2 semanas, ajuste el SoC al 50% aproximadamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous n'utilisez pas votre voiture pendant plus de 2 semaines, réglez le SoC à environ 50 %."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2週間以上使用しない場合は、SoCを約50%に設定してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis bilen ikke skal brukes på over 2 uker, sett SoC til omtrent 50 %."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่ได้ใช้งานรถนานเกิน 2 สัปดาห์ ให้รักษาระดับแบตเตอรี่ไว้ที่ประมาณ 50%"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若车辆停放不用超过 2 周，请将电量调整至 50% 左右。"
          }
        }
      }
    },
    "If running very low in cold conditions, charge immediately while the pack is still warm from driving." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden Sie bei Kälte und niedrigem Akkustand sofort, solange der Akku noch von der Fahrt warm ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If running very low in cold conditions, charge immediately while the pack is still warm from driving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con frío y poca batería, cargue inmediatamente mientras el pack siga caliente del viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par temps froid et batterie faible, chargez immédiatement tant que la batterie est encore chaude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寒冷地で残量が少ない場合は、走行直後のバッテリーが温かいうちにすぐ充電してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis batteriet er lavt i kulde, lad umiddelbart mens batteripakken fortsatt er varm etter kjøring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากแบตเตอรี่เหลือน้อยในสภาพอากาศเย็น ควรรีบเสียบชาร์จทันทีขณะที่แบตเตอรี่ยังอุ่นจากการขับขี่"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果在寒冷天气下电量过低，请趁刚行驶完电池尚有余温时立即充电。"
          }
        }
      }
    },
