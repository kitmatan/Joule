    "Plug in when your battery reaches 15%–20% during normal day-to-day driving." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stecken Sie das Auto im Alltag an, sobald der Akku 15%–20% erreicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plug in when your battery reaches 15%–20% during normal day-to-day driving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enchufe el vehículo cuando la batería alcance el 15%–20% en el día a día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez le véhicule lorsque la batterie atteint 15 %–20 % au quotidien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常の走行では、バッテリー残量が15%〜20%になったら充電プラグを接続してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til laderen når batteriet når 15 %–20 % ved vanlig dagligkjøring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียบชาร์จเมื่อแบตเตอรี่ลดลงเหลือ 15%–20% ในการใช้งานประจำวันทั่วไป"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常行驶中，当电量降至 15%–20% 时即可插枪充电。"
          }
        }
      }
    },
    "Plug into an AC charger and charge to 100% soon to let the BMS balance cells." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie das Auto bald an einen AC-Lader an und laden Sie auf 100%, um die Zellen auszubalancieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plug into an AC charger and charge to 100% soon to let the BMS balance cells."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte pronto a un cargador de CA y cargue al 100% para equilibrar celdas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
