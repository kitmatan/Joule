    "Sign in to keep your charging history private to you and in sync across your iPhone, iPad and Mac." : {
      "comment" : "A description of the sign-in process.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
