    "Log a charge with start and end battery % on your iPhone to estimate State of Health." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfassen Sie eine Ladung mit Start- und End-Batteriestand % auf dem iPhone, um die Batteriegesundheit zu schätzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log a charge with start and end battery % on your iPhone to estimate State of Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una carga con % inicial y final de batería en tu iPhone para estimar la salud de la batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez une recharge avec les % de batterie de début et fin sur votre iPhone pour évaluer l'état de santé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー健全度を推定するため、iPhone で開始・終了％を含む充電を記録してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg en lading med start- og sluttbatteri-% på din iPhone for å estimere batterihelsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการชาร์จพร้อม % แบตเตอรี่เริ่มต้นและสิ้นสุดบน iPhone ของคุณเพื่อประเมินสุขภาพแบตเตอรี่"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上记录包含起始和结束电量百分比的充电，以评估电池健康状态。"
          }
        }
      }
    },
    "Log a charge with start and end battery % to estimate State of Health." : {
