    "Aim to plug in before dropping below 15%–20% State of Charge." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen Sie anzustecken, bevor der SoC unter 15%–20% fällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aim to plug in before dropping below 15%–20% State of Charge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure conectar antes de bajar del 15%–20% de SoC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de brancher avant de descendre sous les 15 %–20 % de SoC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SoCが15%〜20%を下回る前に充電を開始するよう心がけてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikt på å koble til før batteriet faller under 15 %–20 % SoC."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งเป้าหมายเสียบชาร์จก่อนที่แบตเตอรี่จะลดลงต่ำกว่า 15%–20%"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽量在电量降至 15%–20% 以下之前插枪充电。"
          }
        }
      }
    },
    "All charging sessions and battery analytics are stored locally on this device. Sign in with Google to enable automatic cloud backup and cross-device sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ladevorgänge und Batterieanalysen werden lokal auf diesem Gerät gespeichert. Melden Sie sich mit Google an, um automatische Cloud-Backups und geräteübergreifende Synchronisierung zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All charging sessions and battery analytics are stored locally on this device. Sign in with Google to enable automatic cloud backup and cross-device sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las sesiones de carga y análisis de batería se guardan localmente en este dispositivo. Inicia sesión con Google para habilitar copias de seguridad automáticas y sincronización entre dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les sessions de recharge et analyses de batterie sont stockées localement sur cet appareil. Connectez-vous avec Google pour activer la sauvegarde automatique et la synchronisation multi-appareils."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての充電セッションおよびバッテリー分析は、このデバイスのローカルに保存されます。Google でサインインすると、自動クラウドバックアップとデバイス間同期が有効になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle ladeøkter og batterianalyser lagres lokalt på denne enheten. Logg inn med Google for å aktivere automatisk sikkerhetskopi i skyen og synkronisering mellom enheter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการชาร์จและการวิเคราะห์แบตเตอรี่ทั้งหมดจะถูกจัดเก็บไว้ในเครื่องนี้ เข้าสู่ระบบด้วย Google เพื่อเปิดใช้งานการสำรองข้อมูลบนคลาวด์และการซิงค์ระหว่างอุปกรณ์โดยอัตโนมัติ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有充电记录与电池分析数据均存储在此设备的本地。使用 Google 登录可启用自动云备份与跨设备多端同步。"
          }
        }
      }
    },
