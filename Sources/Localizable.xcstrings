    "Cold lithium cells have high internal resistance and cannot accept high charging currents safely, while overheated cells degrade rapidly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalte Lithiumzellen haben einen hohen Innenwiderstand und vertragen keine hohen Ladeströme, während überhitzte Zellen schnell degradieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cold lithium cells have high internal resistance and cannot accept high charging currents safely, while overheated cells degrade rapidly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las celdas frías tienen alta resistencia interna y no aceptan altas corrientes de forma segura, mientras que las recalentadas se degradan rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cellules froides ont une résistance interne élevée et ne peuvent accepter de forts courants sans danger, tandis que les cellules surchauffées se dégradent vite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低温のリチウムセルは内部抵抗が高く高出力を安全に受け入れられず、過熱したセルは急速に劣化します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalde litiumceller har høy indre motstand og tåler ikke høye ladestrømmer, mens overopphetede celler forringes raskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซลล์ลิเธียมที่เย็นจัดจะมีความต้านทานภายในสูงและรับกระแสชาร์จแรงไม่ได้ ในขณะที่เซลล์ที่ร้อนเกินไปจะเสื่อมสภาพอย่างรวดเร็ว"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冰冷的锂电芯具有高内阻且无法安全承受大电流快充，而过热的电芯则会迅速发生化学衰退。"
          }
        }
      }
    },
