    "Higher than expected capacity loss. Consider reviewing charging habits and high-heat DC charging frequency." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höherer Kapazitätsverlust als erwartet. Ladeangewohnheiten und DC-Schnellladen bei Hitze prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher than expected capacity loss. Consider reviewing charging habits and high-heat DC charging frequency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pérdida de capacidad superior a la esperada. Revise los hábitos de carga y la frecuencia de carga rápida en calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perte de capacité plus élevée que prévu. Pensez à revoir vos habitudes et la fréquence de charge DC par forte chaleur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想定以上の容量低下が見られます。充電習慣や高温下での急速充電頻度の見直しを検討してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyere kapasitetstap enn forventet. Vurder å gjennomgå ladevaner og frekvens av DC-hurtiglading i varme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสูญเสียความจุสูงกว่าที่คาดไว้ แนะนำให้ทบทวนพฤติกรรมการชาร์จและลดความถี่ในการชาร์จเร็ว DC ในสภาพอากาศร้อน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量衰减略高于预期。建议检查日常充电习惯并减少高温环境下的直流快充频率。"
          }
        }
      }
    },
