    "Nickel Cobalt Aluminum (NCA)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nickel-Cobalt-Aluminium (NCA)"
          }
        },
        "en" : {
          "stringUnit" : {
