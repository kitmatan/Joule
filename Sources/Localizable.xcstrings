    "In hot climates, try to charge in shaded areas or covered parking garages when feasible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In heißen Regionen möglichst im Schatten oder in überdachten Parkhäusern laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In hot climates, try to charge in shaded areas or covered parking garages when feasible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En climas cálidos, intente cargar en la sombra o en garajes cubiertos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par climat chaud, essayez de recharger à l'ombre ou dans un parking couvert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暑い地域では、日陰や屋根付きの駐車場で充電することをお勧めします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I varmt klima, prøv å lade i skyggen eller i parkeringshus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในสภาพอากาศร้อนจัด ควรเลือกชาร์จในที่ร่มหรืออาคารจอดรถที่มีหลังคาบังแดด"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在炎热气候下，尽量选择在阴凉处或有遮挡的室内停车场进行充电。"
          }
        }
      }
    },
