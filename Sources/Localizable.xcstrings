    "Prioritize AC slow charging at home or destination chargers whenever feasible, reserving DC fast charging for long-distance trips." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevorzugen Sie wenn möglich AC-Langsamer an Zielorten und zu Hause; heben Sie DC für Langstrecken auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritize AC slow charging at home or destination chargers whenever feasible, reserving DC fast charging for long-distance trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priorice la carga lenta de CA y reserve la carga rápida en CC para viajes largos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privilégiez la charge lente AC et réservez la charge rapide DC aux longs trajets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能な限り自宅や目的地の普通充電を優先し、急速充電は長距離移動用に限定してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioriter AC-saktelading hjemme eller på destinasjoner, og spar DC-hurtiglading til langkjøring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกชาร์จช้า AC ที่บ้านหรือจุดหมายปลายทางเป็นหลัก และเก็บการชาร์จเร็ว DC ไว้ใช้เมื่อเดินทางไกล"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽量优先在家或目的地使用交流慢充，将直流快充留给长途出行。"
          }
        }
      }
    },
