    "Never leave your vehicle parked at < 5% State of Charge for extended hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie das Fahrzeug niemals über längere Zeit mit < 5% SoC stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never leave your vehicle parked at < 5% State of Charge for extended hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca deje el vehículo estacionado con < 5% de SoC durante horas prolongadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne laissez jamais le véhicule stationné à moins de 5 % de SoC pendant de longues heures."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残量が5%未満の状態で車を何時間も放置しないでください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aldri bilen stå parkert med under 5 % SoC i lengre perioder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ห้ามจอดรถทิ้งไว้ที่ระดับแบตเตอรี่ต่ำกว่า 5% เป็นเวลานานหลายชั่วโมงโดยเด็ดขาด"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切勿将车辆在低于 5% 的极低电量状态下长时间停放。"
          }
        }
      }
    },
