    "Gentle AC charging (7–11 kW) minimizes internal cell heating, prevents lithium dendrite plating, and preserves the Solid Electrolyte Interphase (SEI) layer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schonendes AC-Laden (7–11 kW) minimiert die Zellwärme, verhindert Lithium-Dendritenbildung und schützt die SEI-Schicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle AC charging (7–11 kW) minimizes internal cell heating, prevents lithium dendrite plating, and preserves the Solid Electrolyte Interphase (SEI) layer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga suave en CA (7–11 kW) minimiza el calentamiento celular, previene dendritas y conserva la capa SEI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge lente AC (7 à 11 kW) minimise l'échauffement interne, prévient les dendrites de lithium et préserve la couche SEI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穏やかな普通充電（7〜11 kW）はセル内部の発熱を抑え、リチウムデンドライトの析出を防ぎ、SEI被膜を保護します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skånsom AC-lading (7–11 kW) minimerer intern oppvarming, forhindrer litiumdendritter og bevarer SEI-laget."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การชาร์จช้า AC (7–11 kW) ช่วยลดความร้อนภายในเซลล์ ป้องกันการเกิดลิเธียมเดนไดรต์ และถนอมชั้น SEI ได้อย่างดีเยี่ยม"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温和的交流慢充 (7–11 kW) 可最大限度减少电芯内部发热，防止锂枝晶析出并保护 SEI 膜。"
          }
        }
      }
    },
