    "LFP has superior thermal stability and suffers far less degradation from full charges compared to NMC." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LFP weist eine höhere thermische Stabilität auf und degradiert bei Vollladung deutlich weniger als NMC."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LFP has superior thermal stability and suffers far less degradation from full charges compared to NMC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LFP tiene mayor estabilidad térmica y sufre mucha menos degradación al cargarse al 100% en comparación con NMC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le LFP possède une stabilité thermique supérieure et souffre bien moins des charges complètes que le NMC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LFPは熱安定性に優れており、NMCと比較して満充電による劣化が極めて少ない特徴があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LFP har overlegen termisk stabilitet og tar langt mindre skade av fullading sammenlignet med NMC."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบตเตอรี่ LFP มีความเสถียรทางความร้อนสูง และเกิดการเสื่อมสภาพจากการชาร์จเต็ม 100% น้อยกว่า NMC มาก"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LFP 具有极高的热稳定性，相比三元锂电池，满电充电带来的衰减要小得多。"
          }
        }
      }
    },
