    "Keep charging to 100% every 1–2 weeks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden Sie weiterhin alle 1–2 Wochen auf 100%."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep charging to 100% every 1–2 weeks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga cargando al 100% cada 1–2 semanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez à charger à 100 % toutes les 1 à 2 semaines."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1〜2週間ごとに100%まで充電する習慣を継続してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett å lade til 100 % hver 1.–2. uke."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชาร์จเต็ม 100% ทุกๆ 1–2 สัปดาห์อย่างต่อเนื่อง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续保持每 1–2 周充满至 100% 一次的习惯。"
          }
        }
      }
    },
    "Keep the vehicle plugged into a slow charger with the target set to 50% so auxiliary systems don't drain the 12V battery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie das Auto mit 50%-Limit am Lader, damit Hilfssysteme die 12V-Batterie nicht entleeren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the vehicle plugged into a slow charger with the target set to 50% so auxiliary systems don't drain the 12V battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deje el coche conectado a un cargador lento al 50% para proteger la batería de 12 V."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le véhicule branché à 50 % pour éviter que les systèmes auxiliaires ne vident la batterie 12 V."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50%目標で普通充電器に接続しておくと、補機用12Vバッテリーの放電も防げます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold bilen tilkoblet en saktelader satt til 50 % slik at 12V-batteriet ikke tappes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียบชาร์จช้าทิ้งไว้โดยตั้งเป้าหมายที่ 50% เพื่อป้องกันไม่ให้ระบบเสริมดึงไฟจากแบตเตอรี่ 12V จนหมด"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将车辆连接到慢充桩并将目标设为 50%，以防止辅助系统耗尽 12V 小电瓶。"
          }
        }
      }
    },
