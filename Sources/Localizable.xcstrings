      }
    },
    "Nickel Cobalt Aluminum (NCA) chemistry delivers high energy density and power output. Limit daily charging to 80%–90% to prolong cell health, reserving 100% top-offs for immediate road trip departures." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nickel-Cobalt-Aluminium (NCA) liefert hohe Energiedichte und Leistung. Begrenzen Sie das tägliche Laden auf 80%–90% und heben Sie 100% für anstehende Reisen auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nickel Cobalt Aluminum (NCA) chemistry delivers high energy density and power output. Limit daily charging to 80%–90% to prolong cell health, reserving 100% top-offs for immediate road trip departures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El níquel-cobalto-aluminio (NCA) ofrece alta densidad energética y potencia. Limite la carga diaria al 80%–90%, reservando el 100% para viajes largos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chimie NCA offre une forte densité énergétique et de puissance. Limitez la charge quotidienne à 80 %–90 % et réservez le 100 % aux départs en voyage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ニッケル・コバルト・アルミニウム（NCA）は高いエネルギー密度と出力を誇ります。日常の充電は80%〜90%に制限し、100%充電は長距離移動時のみに限定してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikkel-kobolt-aluminium (NCA) leverer høy energitetthet og ytelse. Begrens daglig lading til 80 %–90 %, og spar 100 % til umiddelbar avreise på langtur."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบตเตอรี่นิกเกิลโคบอลต์อะลูมิเนียม (NCA) ให้ความหนาแน่นพลังงานและกำลังขับเคลื่อนสูง ควรจำกัดการชาร์จรายวันไว้ที่ 80%–90% เพื่อถนอมเซลล์ และชาร์จ 100% เฉพาะก่อนออกเดินทางไกลทันที"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镍钴铝三元锂 (NCA) 兼具高能量密度与强劲功率。日常请将充电上限限制在 80%–90% 以延长电芯寿命，仅在长途出行前充满 100%。"
          }
        }
      }
    },
