    "**Annual Rate** requires at least 4 sessions spanning 60 days to calculate a yearly trend." : {
      "comment" : "A description of the annual rate of battery degradation.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Jährliche Rate** erfordert mindestens 4 Ladevorgänge über 60 Tage, um einen Jahrestrend zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Annual Rate** requires at least 4 sessions spanning 60 days to calculate a yearly trend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **Tasa anual** requiere al menos 4 sesiones durante 60 días para calcular una tendencia anual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le **Taux annuel** nécessite au moins 4 sessions réparties sur 60 jours pour calculer une tendance annuelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**年間劣化率**の計算には、60日間にわたる少なくとも4回の充電セッションが必要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Årlig rate** krever minst 4 ladeøkter over 60 dager for å beregne en årlig trend."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**อัตราเสื่อมรายปี** ต้องใช้ข้อมูลการชาร์จอย่างน้อย 4 ครั้งในช่วงเวลา 60 วันขึ้นไป เพื่อคำนวณแนวโน้มรายปี"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**年化衰减率**需要至少跨越 60 天的 4 次充电记录以计算年度趋势。"
          }
        }
      }
    },
    "**Annual Rate** requires at least 60 days of charging history to compute a yearly degradation trend." : {
      "comment" : "A description of the annual rate of battery degradation.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Jährliche Rate** erfordert mindestens 60 Tage Ladehistorie, um einen jährlichen Degradationstrend zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Annual Rate** requires at least 60 days of charging history to compute a yearly degradation trend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **Tasa anual** requiere al menos 60 días de historial de carga para calcular una tendencia de degradación anual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le **Taux annuel** nécessite au moins 60 jours d'historique de recharge pour calculer une tendance de dégradation annuelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**年間劣化率**の計算には、少なくとも60日間の充電履歴が必要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Årlig rate** krever minst 60 dagers ladehistorikk for å beregne en årlig degraderingstrend."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**อัตราเสื่อมรายปี** ต้องใช้ประวัติการชาร์จอย่างน้อย 60 วัน เพื่อคำนวณแนวโน้มการเสื่อมสภาพรายปี"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**年化衰减率**需要至少 60 天的充电历史记录以计算年度衰减趋势。"
          }
        }
      }
    },
    "**Degradation Rate** requires at least 4 sessions with odometer readings spanning %@ of driving to establish a reliable distance-based trend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Degradationsrate** erfordert mindestens 4 Ladevorgänge mit Kilometerstand über %1$@ Fahrstrecke, um einen verlässlichen distanzbasierten Trend zu ermitteln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Degradation Rate** requires at least 4 sessions with odometer readings spanning %1$@ of driving to establish a reliable distance-based trend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **Tasa de degradación** requiere al menos 4 sesiones con odómetro durante %1$@ de conducción para establecer una tendencia por distancia confiable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le **Taux de dégradation** nécessite au moins 4 sessions avec kilométrage sur %1$@ de conduite pour établir une tendance kilométrique fiable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**劣化率**の距離ベースの傾向を算出するには、走行距離 %1$@ にわたるオドメーター付きの充電セッションが4回以上必要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Degraderingsrate** krever minst 4 ladeøkter med kilometerteller over %1$@ kjøring for å etablere en pålitelig avstandsbasert trend."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**อัตราการเสื่อมสภาพ** ต้องใช้ข้อมูลที่มีเลขไมล์อย่างน้อย 4 ครั้งในช่วงระยะทางการขับขี่ %1$@ เพื่อประเมินแนวโน้มตามระยะทางที่แม่นยำ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**里程衰减率**需要至少 4 次包含里程读数且跨越 %1$@ 行驶里程的充电记录，以建立可靠的距离趋势。"
          }
        }
      }
    },
