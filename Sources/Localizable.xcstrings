    "Store at 40%–60% SoC for Extended Inactivity" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei längerer Standzeit bei 40%–60% SoC lagern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store at 40%–60% SoC for Extended Inactivity"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacene al 40%–60% de SoC en periodos de inactividad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockez entre 40 % et 60 % de SoC lors d'une inactivité prolongée"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長期間保管する場合はSoC 40%〜60%を維持"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre ved 40 %–60 % SoC ved langvarig inaktivitet"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รักษาระดับแบตเตอรี่ไว้ที่ 40%–60% เมื่อต้องจอดทิ้งไว้นาน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长期停放时保持 40%–60% 电量"
          }
        }
      }
    },
    "Store in a temperature-moderate garage if possible to avoid extreme seasonal thermal extremes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglichst in einer temperaturgeschützten Garage parken, um extreme Temperaturen zu meiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store in a temperature-moderate garage if possible to avoid extreme seasonal thermal extremes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde en un garaje con temperatura moderada para evitar extremos estacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stationnez dans un garage tempéré si possible pour éviter les écarts thermiques extrêmes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "極端な気温変化を避けるため、可能であれば温度管理されたガレージに保管してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre om mulig i en temperaturregulert garasje for å unngå sesongmessige ytterpunkter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอดในโรงรถที่มีอุณหภูมิปานกลางหากทำได้ เพื่อหลีกเลี่ยงสภาพอากาศที่ร้อนหรือหนาวจัดตามฤดูกาล"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽可能停放在温度适宜的室内车库中，以避免季节性极端气温。"
          }
        }
      }
    },
    "Storing an EV battery at extreme charge levels (0% or 100%) for weeks accelerates calendar degradation and irreversible capacity loss." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird ein E-Auto-Akku über Wochen bei Extremwerten (0% oder 100%) gelagert, beschleunigt dies die kalendarische Alterung und irreversible Kapazitätsverluste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing an EV battery at extreme charge levels (0% or 100%) for weeks accelerates calendar degradation and irreversible capacity loss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar una batería de VE en niveles extremos (0% o 100%) durante semanas acelera la degradación y la pérdida irreversible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocker une batterie de VE à des niveaux extrêmes (0 % ou 100 %) pendant des semaines accélère la dégradation calendaire et la perte irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "極端な充電レベル（0%または100%）で長期間放置すると、カレンダー劣化と不可逆的な容量低下が加速します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagring av et elbilbatteri ved ekstreme nivåer (0 % eller 100 %) i uker fremskynder kalenderaldring og irreversibelt kapasitetstap."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจอดรถ EV ทิ้งไว้ที่ระดับแบตเตอรี่สุดโต่ง (0% หรือ 100%) เป็นเวลาหลายสัปดาห์ จะเร่งการเสื่อมสภาพตามเวลาและการสูญเสียความจุถาวร"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将电动汽车电池在极端电量（0% 或 100%）下停放数周会加速日历老化并造成不可逆的容量损失。"
          }
        }
      }
    },
