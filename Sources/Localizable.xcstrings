        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ควรเสียบชาร์จ AC ให้เต็ม 100% ในเร็วๆ นี้ เพื่อให้ระบบ BMS ปรับสมดุลเซลล์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
