    "Charging on %@ saved you %@ this month compared to peak daytime rates (%@ kWh logged)." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Laden mit %1$@ hat Ihnen diesen Monat %2$@ gegenüber Spitzenzeiten erspart (%3$@ kWh geladen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charging on %1$@ saved you %2$@ this month compared to peak daytime rates (%3$@ kWh logged)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargar con %1$@ te ahorró %2$@ este mes en comparación con tarifas pico (%3$@ kWh registrados)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recharger avec %1$@ vous a fait économiser %2$@ ce mois-ci par rapport aux heures pleines (%3$@ kWh enregistrés)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ での充電により、日中ピーク料金と比較して今月 %2$@ の節約になりました (記録電力量: %3$@ kWh)。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lading med %1$@ sparte deg for %2$@ denne måneden sammenlignet med topppriser (%3$@ kWh logget)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การชาร์จด้วย %1$@ ช่วยคุณประหยัด %2$@ ในเดือนนี้เมื่อเทียบกับช่วง Peak (ชาร์จไป %3$@ kWh)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本月使用 %1$@ 充电相比白天高峰期电价为您节省了 %2$@ (共记录 %3$@ kWh)。"
          }
        }
      }
    },
    "Charging on %1$@ saved you %2$@ this month compared to peak daytime rates (%3$.1f kWh logged)." : {
      "localizations" : {
        "de" : {
