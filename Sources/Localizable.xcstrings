          }
        }
      }
    },
    "You can continue using Joule completely offline. Signing in later will safely merge your local sessions into the cloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Joule komplett offline nutzen. Bei späterer Anmeldung werden Ihre lokalen Daten sicher synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can continue using Joule completely offline. Signing in later will safely merge your local sessions into the cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes seguir usando Joule desconectado. Iniciar sesión más tarde sincronizará de forma segura tus sesiones en la nube."
