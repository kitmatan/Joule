    "Set your vehicle charge limit to 80% (or 90%) for daily driving, reserving 100% only for long road trips." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie das Limit im Alltag auf 80% (oder 90%) und heben Sie 100% für Reisen auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set your vehicle charge limit to 80% (or 90%) for daily driving, reserving 100% only for long road trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste el límite al 80% (o 90%) para uso diario, reservando el 100% para viajes largos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez la limite à 80 % (ou 90 %) au quotidien, réservant le 100 % aux longs trajets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常の充電上限を80%（または90%）に設定し、100%は長距離移動時のみに限定してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett ladegrensen til 80 % (eller 90 %) til daglig, og spar 100 % til langkjøring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าขีดจำกัดการชาร์จไว้ที่ 80% (หรือ 90%) ในชีวิตประจำวัน และชาร์จ 100% เฉพาะเมื่อเดินทางไกล"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将日常充电上限设为 80%（或 90%），仅在长途出行时才充至 100%。"
          }
        }
      }
    },
    "Set your vehicle's charge limit slider to 80% (or 90% maximum) for daily commutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie das Ladelimit im Fahrzeug für den Alltag auf 80% (maximal 90%) ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set your vehicle's charge limit slider to 80% (or 90% maximum) for daily commutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure el límite de carga de su vehículo al 80% (o 90% máximo) para el día a día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez la limite de charge de votre véhicule à 80 % (ou 90 % max) pour les trajets quotidiens."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常の走行では、車両の充電上限スライダーを80%（最大でも90%）に設定してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still inn ladegrensen i bilen til 80 % (maks 90 %) for daglig pendling."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าขีดจำกัดการชาร์จในรถยนต์ไว้ที่ 80% (หรือไม่เกิน 90%) สำหรับการใช้งานประจำวัน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常通勤请将车辆充电限制滑块设置为 80%（最高不超过 90%）。"
          }
        }
      }
    },
    "Setting an 80%–90% daily charge limit will significantly reduce high-voltage cathode stress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein tägliches Limit von 80%–90% verringert die Kathodenspannung und schützt den Akku."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setting an 80%–90% daily charge limit will significantly reduce high-voltage cathode stress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establecer un límite diario de 80%–90% reducirá el estrés por alto voltaje en el cátodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Régler une limite quotidienne de 80 %–90 % réduira considérablement le stress de la cathode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常の充電上限を80%〜90%に設定すると、正極の高電圧負荷が大幅に軽減されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å sette en daglig grense på 80 %–90 % vil redusere høyspenningsbelastningen betydelig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งขีดจำกัดการชาร์จรายวันไว้ที่ 80%–90% จะช่วยลดความเค้นจากแรงดันสูงที่ขั้วแคโทดได้อย่างมาก"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将日常充电上限设定为 80%–90% 可显著减轻正极高电压损耗。"
          }
        }
      }
    },
