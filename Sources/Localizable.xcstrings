    "Regular AC charging and periodic 100% calibration will keep your LFP cells balanced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regelmäßiges AC-Laden und periodische 100%-Kalibrierung halten die LFP-Zellen im Gleichgewicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular AC charging and periodic 100% calibration will keep your LFP cells balanced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga regular en CA y calibraciones al 100% mantendrán equilibradas las celdas LFP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une recharge AC régulière et une calibration périodique à 100 % maintiennent les cellules LFP équilibrées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定期的な普通充電と100%校正により、LFPセルのバランスが保たれます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jevnlig AC-lading og periodisk 100 % kalibrering holder LFP-cellene balansert."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การชาร์จ AC เป็นประจำและการปรับเทียบ 100% เป็นระยะจะช่วยรักษาสมดุลของเซลล์ LFP"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经常使用慢充并定期充满至 100% 可保持 LFP 电芯良好均衡。"
          }
        }
      }
    },
    "Rely on Home or Work AC chargers for >= 70% of your total energy intake." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie für >= 70% Ihres Energiebedarfs AC-Lader zu Hause oder am Arbeitsplatz."
          }
        },
